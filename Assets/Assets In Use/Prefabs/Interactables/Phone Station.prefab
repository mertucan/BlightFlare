  itemEntries:
  - itemName: Blood Bag
    icon: {fileID: 2409934984381817930, guid: 39609eed6671fae468b4ffc9683b580d, type: 3}
    description: Increases your maximum health by one full heart and fully restores
      your health.
  - itemName: Bobby Bomb
    icon: {fileID: 6871975214743837415, guid: 4d87a75dcb769b942b61a361bcfbf2be, type: 3}
    description: Your bombs seek out nearby active enemies before exploding.
  - itemName: Bob's Curse
    icon: {fileID: 531679483, guid: 86df9a697c7e69f4a915772b513b6bf3, type: 3}
    description: Grants one extra bomb and replaces your bombs with poisonous bombs
      that leave a damaging poison cloud.
  - itemName: Ceremonial Robe
    icon: {fileID: 2026868347363109891, guid: c91581b1b3ca21b49a81ed5d6641a240, type: 3}
    description: Increases your maximum health by two full hearts, heals you, and
      adds a dark robe visual effect.
  - itemName: Holy Mantle
    icon: {fileID: -2817642328477022762, guid: 77cf480169d45684787a77f34aed1209, type: 3}
    description: Gives you a protective shield that blocks one hit before breaking.
  - itemName: Hot Bombs
    icon: {fileID: -8802682024482322321, guid: 39ed084af520a3447ac40f589cc078bc, type: 3}
    description: Your bombs leave behind a fire hazard after exploding, damaging
      enemies that stand in it.
  - itemName: Leo
    icon: {fileID: 4117363993859357139, guid: ae3049802a03c9046be65759e8e89b01, type: 3}
    description: Changes your head appearance and lets you break destructible objects
      by walking into them.
  - itemName: Pyromaniac
    icon: {fileID: 8373805363917326335, guid: 76e7937c34b261147998d6c2b9af8d9a, type: 3}
    description: Grants one extra bomb and lets explosions heal you for half a heart
      instead of only being dangerous.
  - itemName: Seraphim
    icon: {fileID: -2082690812626470491, guid: 33634cae2ea2830468db1cb4dcaef1f6, type: 3}
    description: Gives you a flying form, changing your body sprites and allowing
      you to ignore destructible and obstacle collisions.
  - itemName: Taurus
    icon: {fileID: -6541733775929675393, guid: 2666ca426fb31ab40840eb3d97d38d4c, type: 3}
    description: In enemy rooms, your speed gradually increases up to a bonus cap
      and resets when you leave the room.
  - itemName: Blood of the Marytr
    icon: {fileID: 3623456089048840555, guid: c7f4c172ac4af024483fcabbf008d3b3, type: 3}
    description: Changes your head appearance and prevents damage from traps such
      as spikes.
  panelSize: {x: 1120, y: 720}
  iconsPerRow: 5
